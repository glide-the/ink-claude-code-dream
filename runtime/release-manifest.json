{
  "schemaVersion": "ink-claude-cli-envelope/v1",
  "runtime": {
    "name": "ink-claude-code-dream",
    "version": "0.1.6",
    "entrypoint": "bin/ink-claude-code-dream",
    "integration": {
      "environment": "CLAUDE_CODE_CLI_PATH",
      "sdkOption": "ClaudeAgentOptions.cli_path",
      "sdkDistribution": "ink-claude-dream-agent-sdk",
      "sdkVersion": "0.2.145",
      "dreamObservedSdkVersion": "0.2.145",
      "sdkModified": false
    }
  },
  "core": {
    "package": "@anthropic-ai/claude-code",
    "version": "2.1.241",
    "delivery": "external-not-bundled",
    "execution": "unmodified-as-published",
    "loadingReduction": 0,
    "corePruned": false,
    "productionEligible": false,
    "blockingReasons": [
      "NO_CURRENT_OFFICIAL_SOURCE_BUILD_GRAPH",
      "NO_WRITTEN_MODIFICATION_AUTHORIZATION",
      "NO_WRITTEN_REDISTRIBUTION_AUTHORIZATION",
      "REQUIRED_CAPABILITY_REACHABILITY_NOT_PROVABLE_ON_NATIVE_BINARY"
    ]
  },
  "protocol": {
    "name": "claude-code-stream-json",
    "version": 1,
    "semantics": "opaque argv, stdin, stdout, stderr, cwd, and environment forwarding"
  },
  "commands": {
    "headless": "opaque stream-json forwarding",
    "management": [
      "--help",
      "--version",
      "-h",
      "-v",
      "mcp add",
      "mcp get",
      "mcp list",
      "mcp login",
      "mcp logout",
      "mcp remove",
      "mcp --help",
      "mcp --version",
      "auth login",
      "auth logout",
      "auth status",
      "setup-token"
    ]
  },
  "capabilityEvidence": "manifest/capabilities.json",
  "contracts": {
    "artifact": "manifest/artifact-manifest.json",
    "entrypointPolicy": "manifest/entrypoint-policy.json",
    "runtimeData": "manifest/runtime-data-contract.json",
    "bareProfile": "manifest/bare-profile.json",
    "licenses": "manifest/dependency-licenses.json",
    "pruningDecision": "manifest/pruning-decision.json"
  },
  "legalGate": {
    "binary": "unmodified-as-published",
    "authentication": "unaltered-opaque-pass-through",
    "branding": "wrapper-is-not-Claude-Code"
  },
  "mcpVersionsRegressed": [
    "1.27.0",
    "1.27.1"
  ],
  "claudeCodeMcpChangelogVersions": [
    "2.1.239",
    "2.1.238"
  ],
  "trustBoundary": "Deployment verifies the external pinned core with --runtime-doctor; published CLI flags, including version and authentication commands, are otherwise passed to the unmodified external binary."
}
