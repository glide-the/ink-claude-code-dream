{
  "schemaVersion": "ink-cleanroom-npm-policy/v1",
  "repository": "glide-the/ink-claude-code-dream",
  "version": "0.1.3",
  "license": "MIT",
  "bunVersion": "1.4.0",
  "entrypoint": "src/cleanroom/cli.ts",
  "buildRoot": "dist/cleanroom-targets",
  "stageRoot": "dist/cleanroom-npm/stage",
  "tarballRoot": "dist/cleanroom-npm/tarballs",
  "metaPackage": {
    "name": "@glide-the/ink-claude-code-dream",
    "commands": [
      "claude",
      "ink-claude-code-dream"
    ]
  },
  "platforms": {
    "darwin-arm64": {
      "package": "@glide-the/ink-claude-code-dream-darwin-arm64",
      "os": "darwin",
      "cpu": "arm64",
      "bunTarget": "bun-darwin-arm64",
      "binaryFormat": "mach-o-64-arm64"
    },
    "darwin-x64": {
      "package": "@glide-the/ink-claude-code-dream-darwin-x64",
      "os": "darwin",
      "cpu": "x64",
      "bunTarget": "bun-darwin-x64",
      "binaryFormat": "mach-o-64-x64"
    },
    "linux-arm64": {
      "package": "@glide-the/ink-claude-code-dream-linux-arm64",
      "os": "linux",
      "cpu": "arm64",
      "bunTarget": "bun-linux-arm64",
      "binaryFormat": "elf-64-arm64"
    },
    "linux-x64": {
      "package": "@glide-the/ink-claude-code-dream-linux-x64",
      "os": "linux",
      "cpu": "x64",
      "bunTarget": "bun-linux-x64",
      "binaryFormat": "elf-64-x64"
    }
  },
  "materialPolicy": {
    "sourceMapsAllowed": false,
    "platformFiles": [
      "LICENSE",
      "README.md",
      "SHA256SUMS",
      "THIRD_PARTY_NOTICES.txt",
      "npm-publication-attestation.json",
      "package.json",
      "runtime-manifest.json",
      "runtime/bin/ink-claude-code-dream",
      "runtime/manifest/artifact-manifest.json",
      "runtime/manifest/capabilities.json",
      "runtime/manifest/dependency-licenses.json",
      "runtime/manifest/sbom.cdx.json",
      "runtime/release-manifest.json",
      "scripts/prepack.mjs"
    ],
    "metaFiles": [
      "LICENSE",
      "README.md",
      "SHA256SUMS",
      "THIRD_PARTY_NOTICES.txt",
      "bin/ink-claude-code-dream",
      "manifest/artifact-manifest.json",
      "manifest/capabilities.json",
      "manifest/dependency-licenses.json",
      "manifest/sbom.cdx.json",
      "npm-publication-attestation.json",
      "package.json",
      "release-manifest.json",
      "runtime-manifest.json",
      "scripts/prepack.mjs"
    ],
    "forbiddenSuffixes": [
      ".map"
    ],
    "forbiddenPathSegments": [
      ".claude",
      "core-local",
      "core-package-local",
      "credentials",
      "oauth-token",
      "restored-src",
      "sessions",
      "transcript",
      "transcripts",
      "workspace"
    ],
    "forbiddenBytePatterns": [
      "/claude-code-sourcemap/restored-src",
      "LicenseRef-Anthropic-All-Rights-Reserved",
      "core-package-local",
      "restored-src"
    ]
  },
  "publication": {
    "packageGenerationAllowed": true,
    "npmPublishAllowed": true,
    "reason": "The checked clean-room policy, final Dream acceptance receipt, and explicit public release authorization passed."
  }
}
