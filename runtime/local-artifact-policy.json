{
  "schemaVersion": "ink-core-local-artifact-policy/v1",
  "artifact": {
    "name": "ink-claude-code-dream",
    "version": "0.1.0",
    "directory": "dist/core-package-local/ink-claude-code-dream-0.1.0",
    "entrypoint": "bin/ink-claude-code-dream",
    "coreEntrypoint": "lib/core/cli.js",
    "bunVersion": "1.4.0",
