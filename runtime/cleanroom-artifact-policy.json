    "businessAcceptance": {
      "required": true,
      "passed": true,
      "receiptPath": "runtime/attestations/dream-real-business-acceptance-0.1.2.json",
      "receiptSha256": "16a4782a8829c11a9cf899e2b021e40de8eb02f8aa23317f7b6bf492809051fc",
      "boundary": "Dream, Admin, Gateway, and the normal local PostgreSQL through public production entrypoints"
    },
    "targetHostQualification": {
      "darwin-arm64": true,
      "darwin-x64": true,
      "linux-arm64": true,
      "linux-x64": true
    },
    "targetQualificationBasis": {
      "darwin-arm64": "real-host-business-and-native-execution",
      "darwin-x64": "cross-target-native-format-package-and-reproducibility",
      "linux-arm64": "cross-target-native-format-package-and-reproducibility",
      "linux-x64": "cross-target-native-format-package-and-reproducibility"
    },
    "requiredEvidence": [
      "repository-source-inventory",
      "dependency-license-report",
      "zero-restored-source-provenance",
      "sdk-process-contract",
      "mcp-stdio-http-oauth-resources-contract",
      "workspace-sandbox-resume-contract",
      "four-target-native-qualification",
      "reproducible-five-package-verification",
      "dream-real-business-acceptance",
      "explicit-public-npm-release-authorization"
