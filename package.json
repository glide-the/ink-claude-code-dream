{
  "name": "ink-claude-code-dream",
  "version": "0.1.9",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Dream Runtime built from the original restored Claude Code module structure",
  "engines": {
    "node": ">=22.0.0 <25.0.0",
    "bun": ">=1.2.20 <2.0.0"
  },
  "packageManager": "bun@1.4.0",
  "inkBuild": {
    "archiveNode": "24.13.0",
    "coreBun": "1.4.0",
    "nativeTargets": [
      "darwin-arm64",
      "darwin-x64",
      "linux-arm64",
      "linux-x64"
    ]
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "source:verify": "node scripts/verify-original-source.mjs",
    "build": "./node_modules/.bin/bun scripts/build.ts",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:upstream-sdk": "node scripts/run-unified-sdk-contract.mjs",
    "test:mcp-source": "node scripts/run-unified-sdk-contract.mjs --mcp",
    "test:acceptance": "node scripts/run-source-smoke.mjs",
    "test:mcp-matrix": "node scripts/run-mcp-matrix.mjs",
    "test:mcp-auth-compat": "./node_modules/.bin/bun --cwd compat/mcp-auth test",
    "test:dream-compat": "./node_modules/.bin/bun test compat/dream-runtime",
    "test:core-oauth": "node scripts/run-core-oauth-cli-contract.mjs",
    "test:pruning-evidence": "node scripts/verify-core-prune.mjs",
    "build:core-local": "./node_modules/.bin/bun scripts/build-core-prune.ts",
    "verify:core-local": "./node_modules/.bin/bun scripts/build-core-prune.ts && node scripts/verify-core-prune.mjs",
    "install:core-local": "node scripts/install-core-local.mjs",
    "test:reproducible": "node scripts/check-reproducible.mjs",
    "verify": "bun run lint && bun run test && bun run build && node scripts/verify-core-prune.mjs && bun run test:mcp-auth-compat && bun run test:upstream-sdk && bun run test:mcp-source && bun run test:acceptance && bun run test:reproducible",
    "package": "bun run release:pack",
    "release:pack": "bun run build && node scripts/verify-core-prune.mjs && node scripts/package-core-local.mjs",
    "npm:plan": "node scripts/npm-release.mjs plan",
    "npm:templates": "node scripts/npm-release.mjs templates",
    "npm:legal": "node scripts/npm-release.mjs legal",
    "npm:gate": "node scripts/npm-release.mjs gate",
    "npm:stage": "node scripts/npm-release.mjs stage",
    "npm:aggregate-meta": "node scripts/npm-release.mjs aggregate-meta",
    "npm:smoke": "node scripts/smoke-npm-release.mjs",
    "prepack": "node scripts/npm-root-guard.mjs",
    "prepublishOnly": "node scripts/npm-root-guard.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sandbox-runtime-legacy": "npm:@anthropic-ai/sandbox-runtime@0.0.45",
    "@anthropic-ai/sdk": "0.74.0",
    "@grpc/grpc-js": "1.14.0",
    "@protobufjs/codegen": "2.0.5",
    "@protobufjs/fetch": "1.1.1",
    "@protobufjs/path": "1.1.2",
    "ajv": "8.17.1",
    "bun": "1.4.0",
    "diff": "8.0.2",
    "esbuild": "0.25.9",
    "lodash.camelcase": "4.3.0",
    "protobufjs": "7.5.4",
    "sharp": "0.34.5",
    "tar-stream": "3.1.7",
    "zod": "4.0.0",
    "zod-to-json-schema": "3.25.2"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.73",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ansi-styles": "6.2.3",
    "is-fullwidth-code-point": "5.1.0",
    "signal-exit": "4.1.0"
  }
}
