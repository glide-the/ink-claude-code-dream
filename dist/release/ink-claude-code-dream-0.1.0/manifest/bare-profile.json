{
  "schemaVersion": "ink-claude-bare-profile/v1",
  "profile": "dream-explicit-v1",
  "status": "experimental-opt-in-not-production-default",
  "officialSemantics": {
    "flag": "--bare",
    "environmentSetByOfficialCli": "CLAUDE_CODE_SIMPLE",
    "skipsAutoDiscovery": [
      "hooks",
      "skills",
      "custom-commands",
      "subagents",
      "plugins",
      "mcp-servers",
      "auto-memory",
      "CLAUDE.md"
    ],
    "authentication": "official bare mode does not read OAuth credentials or the system keychain"
  },
  "activation": {
    "callerMustPassFlag": "--bare",
    "callerMustSetEnvironment": "INK_CLAUDE_BARE_PROFILE=dream-explicit-v1",
    "wrapperMustNotInjectFlag": true,
    "managementCommandsExcluded": true
  },
  "requiredExplicitCarriers": {
    "headless": "-p or --print",
    "settingsForHooksSandboxPermissions": "--settings <absolute-file>",
    "mcpServers": "--strict-mcp-config plus --mcp-config <absolute-file>",
    "pluginsAndSkills": "one or more --plugin-dir <absolute-directory-or-zip>",
    "workspace": "cwd equals INK_CLAUDE_RUNTIME_WORKSPACE_ROOT",
    "threadTmpdir": "existing CLAUDE_CODE_TMPDIR exact-child contract",
    "resume": "resume/session argv is forwarded exactly; --no-session-persistence is rejected"
  },
  "authentication": {
    "wrapper": "does-not-inspect-remove-disable-restrict-or-select-authentication",
    "callerResponsibility": "choose an official bare-compatible method explicitly",
    "automaticConversion": false
  },
  "acceptanceGate": "Do not enable for Dream production until settings/MCP/plugin contents and real new-session/resume/SSE/tools/sandbox/auth flows pass end-to-end."
}
