{
  "schemaVersion": "ink-claude-cli-envelope/v1",
  "runtime": {
    "name": "ink-minimal-claude-code-runtime",
    "version": "0.1.0",
    "entrypoint": "bin/ink-claude-runtime.mjs",
    "integration": {
      "environment": "CLAUDE_CODE_CLI_PATH",
      "sdkOption": "ClaudeAgentOptions.cli_path",
      "sdkVersion": "0.2.140",
      "sdkModified": false
    }
  },
  "core": {
    "package": "@anthropic-ai/claude-code",
    "version": "2.1.235",
    "delivery": "external-not-bundled",
    "loadingReduction": 0
  },
  "protocol": {
    "name": "claude-code-stream-json",
    "version": 1,
    "semantics": "opaque argv, stdin, stdout, stderr, cwd, and environment forwarding"
  },
  "commands": {
    "headless": "opaque stream-json forwarding",
    "management": [
      "--help",
      "--version",
      "mcp add",
      "mcp get",
      "mcp list",
      "mcp login",
      "mcp logout",
      "mcp remove",
      "mcp --help",
      "mcp --version"
    ]
  },
  "capabilityEvidence": "manifest/capabilities.json",
  "mcpVersionsRegressed": [
    "1.27.0",
    "1.27.1"
  ],
  "trustBoundary": "Deployment verifies the external pinned core with --runtime-doctor; normal launches do not add a second core version process."
}
